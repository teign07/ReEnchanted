{
  "name": "reenchanted-physical-book-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "rehearse:sandbox-preflight": "node rehearse-sandbox-preflight.mjs",
    "test:monthly": "node --test test-monthly-issues.mjs",
    "test:monthly-runtime": "node test-monthly-runtime.mjs",
    "test:monthly-delivery": "node test-monthly-delivery.mjs",
    "check": "node --check lulu-quote-worker.mjs",
    "test:pricing": "node test-pricing.mjs",
    "test:preview": "node test-order-preview.mjs",
    "test:print-submission": "node --test test-print-submission.mjs",
    "test:reconciliation": "node --test test-reconciliation.mjs",
    "test:membership-checkout": "node --test test-membership-checkout.mjs",
    "test:gift-claim-runtime": "node test-gift-claim-runtime.mjs",
    "test:memberships": "node test-memberships.mjs && node test-membership-dispatch.mjs",
    "test:gifts": "node test-gifts.mjs",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test:parcel-support": "node --test test-parcel-support.mjs",
    "test:membership-ownership": "node --test test-membership-ownership.mjs",
    "test:membership-recovery": "node --test test-membership-recovery.mjs",
    "test:recovery-mail": "node --test test-gmail-recovery-delivery.mjs"
